# ============================================================================
# Placement Practice Portal — Environment Variables Template
# ============================================================================

NODE_ENV=development
PORT=5000

# Supabase PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres
DATABASE_SSL=true

# Security & JWT Authentication
JWT_SECRET=replace_with_secure_random_jwt_secret
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=https://practice-portal-mu.vercel.app

# GitHub App Integration (OAuth / User Authorization)
# Documentation: https://github.com/settings/apps
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_APP_NAME=
GITHUB_CALLBACK_URL=https://practice-portal-kmri.onrender.com/api/github/callback
GITHUB_ENCRYPTION_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_OAUTH_SCOPES=read:user,repo
