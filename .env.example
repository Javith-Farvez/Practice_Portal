# ============================================================================
# Placement Practice Portal — Environment Variables Template
# ============================================================================

NODE_ENV=development
PORT=5000

# Supabase PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres
DATABASE_SSL=true

# Security & JWT Authentication
JWT_SECRET=replace_with_secure_random_jwt_secret
JWT_EXPIRES_IN=7d

# CORS Allowed Origin / Frontend URL
CLIENT_URL=https://practice-portal-mu.vercel.app
FRONTEND_URL=https://practice-portal-mu.vercel.app

# GitHub OAuth App Integration
# Documentation: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_CALLBACK_URL=https://practice-portal-kmri.onrender.com/api/github/callback
GITHUB_OAUTH_SCOPES=read:user,repo
