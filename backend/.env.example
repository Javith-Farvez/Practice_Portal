NODE_ENV=development
PORT=5000

# Supabase PostgreSQL Connection String (Direct or Session Pooler)
# Direct connection format:
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or Session Pooler format (IPv4 / transaction pooler):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

DATABASE_SSL=true

# Security & JWT Authentication
JWT_SECRET=replace_with_secure_secret
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# Compiler Sandbox Engine
DOCKER_AVAILABLE=false
EXECUTION_TIMEOUT_MS=5000
MAX_MEMORY_MB=128

# GitHub App Integration (OAuth / User Authorization)
# Settings: https://github.com/settings/apps or https://github.com/settings/developers
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_PRIVATE_KEY=
GITHUB_APP_NAME=
GITHUB_CALLBACK_URL=
GITHUB_ENCRYPTION_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_OAUTH_SCOPES=read:user,repo

