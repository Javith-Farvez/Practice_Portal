NODE_ENV=development
PORT=5000

# Supabase PostgreSQL Connection String (Direct or Session Pooler)
# Direct connection format:
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or Session Pooler format (IPv4 / transaction pooler):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

DATABASE_SSL=true

# Security & JWT Authentication
JWT_SECRET=replace_with_secure_secret
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:5173

# Compiler Sandbox Engine
DOCKER_AVAILABLE=false
EXECUTION_TIMEOUT_MS=5000
MAX_MEMORY_MB=128

# GitHub OAuth Integration
# 1. Go to: https://github.com/settings/developers → "New OAuth App"
# 2. Homepage URL: https://practice-portal-mu.vercel.app
# 3. Callback URL: https://practice-portal-kmri.onrender.com/api/github/callback
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
GITHUB_CALLBACK_URL=https://practice-portal-kmri.onrender.com/api/github/callback
GITHUB_OAUTH_SCOPES=read:user,repo
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GITHUB_ENCRYPTION_KEY=replace_with_64_hex_char_random_key
