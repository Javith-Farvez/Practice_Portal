# ===========================================================================
# Placement Practice Portal — Backend Environment Variables
# Copy this file to .env and fill in all values before running locally.
# NEVER commit .env to source control (it's in .gitignore).
# ===========================================================================

NODE_ENV=development
PORT=5001

# ---------------------------------------------------------------------------
# Supabase PostgreSQL Connection String
# ---------------------------------------------------------------------------
# Session Pooler format (recommended for serverless / Render):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Direct connection format:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

DATABASE_SSL=true

# ---------------------------------------------------------------------------
# JWT Authentication
# ---------------------------------------------------------------------------
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_strong_random_secret
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# CORS — Allowed frontend origin
# ---------------------------------------------------------------------------
# Local development:
CLIENT_URL=http://localhost:5173
# Production (set this in Render):
# CLIENT_URL=https://practice-portal-mu.vercel.app

# ---------------------------------------------------------------------------
# GitHub OAuth App Integration
# ---------------------------------------------------------------------------
# Setup guide: see GITHUB_SETUP.md
#
# 1. Go to https://github.com/settings/developers → OAuth Apps → New OAuth App
# 2. Set Authorization callback URL to your backend /api/github/callback
# 3. Copy Client ID and Client Secret below (or set them in Render Environment)
# 4. Never expose GITHUB_CLIENT_SECRET in frontend code or Vercel env vars

# Your GitHub OAuth App Client ID (from github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_oauth_client_id

# Your GitHub OAuth App Client Secret (NEVER commit real secret — only set in Render)
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret

# Must exactly match the "Authorization callback URL" in your GitHub OAuth App settings
# Production: https://practice-portal-kmri.onrender.com/api/github/callback
# Local dev:  http://localhost:5001/api/github/callback
GITHUB_CALLBACK_URL=https://practice-portal-kmri.onrender.com/api/github/callback

# Frontend URL for OAuth redirects (and CORS)
FRONTEND_URL=https://practice-portal-mu.vercel.app

# OAuth scopes — read:user for profile info, repo for repository access
GITHUB_OAUTH_SCOPES=read:user,repo

# ---------------------------------------------------------------------------
# Optional / Advanced
# ---------------------------------------------------------------------------
DOCKER_AVAILABLE=false
EXECUTION_TIMEOUT_MS=5000
MAX_MEMORY_MB=128
